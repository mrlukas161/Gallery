<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- Domov: hľadanie, čo treba upratať, skratky, stav spracovania a priečinky -->
    <LinearLayout
        android:id="@+id/home_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/normal_margin">

        <!-- hľadanie čohokoľvek (osoba, text, miesto, vec) -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/home_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/normal_margin"
            android:background="@drawable/ripple_all_corners"
            android:clickable="true"
            android:drawablePadding="10dp"
            android:focusable="true"
            android:padding="@dimen/activity_margin"
            android:text="@string/home_search_hint" />

        <!-- Na upratanie: série a duplikáty z pHash indexu -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_cleanup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/normal_margin"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/activity_margin">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="🧹"
                    android:textSize="30sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/normal_margin">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/home_cleanup_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_cleanup_title"
                        android:textSize="@dimen/bigger_text_size"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/home_cleanup_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- štyri skratky na najpoužívanejšie obrazovky -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/normal_margin"
            android:orientation="horizontal">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/home_tile_people"
                style="@style/HomeTile"
                android:text="@string/people" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/home_tile_docs"
                style="@style/HomeTile"
                android:text="@string/docs_title" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/home_tile_places"
                style="@style/HomeTile"
                android:text="@string/explore_places" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/home_tile_memories"
                style="@style/HomeTile"
                android:text="@string/memories_title" />
        </LinearLayout>

        <!-- druhý rad rýchlych akcií: fotoaparát a obľúbené (texty z commons — sú preložené) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/normal_margin"
            android:orientation="horizontal">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/home_tile_camera"
                style="@style/HomeTile"
                android:text="@string/a1_tile_camera" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/home_tile_favorites"
                style="@style/HomeTile"
                android:text="@string/a1_tile_favorites" />
        </LinearLayout>

        <!-- stav spracovania knižnice (ťuknutím sa dokončí zvyšok) -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/home_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/normal_margin"
            android:background="@drawable/ripple_all_corners"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/activity_margin" />

        <!-- priečinky: hlavička mení zoradenie, pod ňou zoznam -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/home_folders_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ripple_all_corners"
            android:clickable="true"
            android:focusable="true"
            android:padding="@dimen/activity_margin"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/home_folders_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
