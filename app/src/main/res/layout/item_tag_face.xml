<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="2dp">

    <org.fossify.commons.views.MySquareImageView
        android:id="@+id/tag_face_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop" />

    <!-- fajka vybranej tváre — rovnaký vzhľad ako v mriežke fotiek (farby témy sa nastavia v adaptéri) -->
    <ImageView
        android:id="@+id/tag_face_check"
        android:layout_width="@dimen/selection_check_size"
        android:layout_height="@dimen/selection_check_size"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/medium_margin"
        android:background="@drawable/circle_background"
        android:contentDescription="@string/tag_faces_title"
        android:padding="@dimen/tiny_margin"
        android:src="@drawable/ic_check_vector"
        android:visibility="gone" />

</FrameLayout>
