<?xml version="1.0" encoding="utf-8"?>
<!-- Sféra: snímanie (náhľad + navádzanie + ovládanie) a výsledok skladania -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sphere_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/sphere_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <org.fossify.gallery.sphere.SphereGuideView
        android:id="@+id/sphere_guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/sphere_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="190dp"
        android:background="@drawable/ic_sfera_hint_bg"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/sphere_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#66000000"
        android:orientation="vertical"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/sphere_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sfera_c_close"
                android:padding="12dp"
                android:src="@drawable/ic_sfera_close" />

            <TextView
                android:id="@+id/sphere_counter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/sphere_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sfera_c_more"
                android:padding="12dp"
                android:src="@drawable/ic_sfera_more" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sphere_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/sphere_lens_wide"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/ic_sfera_chip_bg"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/sfera_c_lens_wide"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sphere_lens_main"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/ic_sfera_chip_bg"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/sfera_c_lens_main"
                android:textSize="14sp"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sphere_lock_exposure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/sfera_c_lock_exposure"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sphere_bottombar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#66000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/sphere_undo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_sfera_undo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sfera_c_undo"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/sphere_shutter"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="@string/sfera_c_shutter"
            android:src="@drawable/ic_sfera_shutter" />

        <TextView
            android:id="@+id/sphere_done"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_weight="1"
            android:background="@drawable/ic_sfera_btn_bg"
            android:gravity="center"
            android:text="@string/sfera_c_done"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sphere_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/ic_sfera_card_bg"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sfera_c_tip_title"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sfera_c_tip_1"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/sfera_c_tip_2"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/sfera_c_tip_3"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/sphere_tips_ok"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/ic_sfera_btn_bg"
            android:gravity="center"
            android:text="@string/sfera_c_tip_ok"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- výsledok skladania -->
    <ScrollView
        android:id="@+id/sphere_result"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF121212"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sphere_result_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/sphere_result_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/sphere_result_image"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="20dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/sphere_result_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:max="1000" />

            <TextView
                android:id="@+id/sphere_result_stage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/sphere_result_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/sfera_c_result_note"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/sphere_result_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="#FFFF8A80"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sphere_btn_view"
                style="@style/SferaCaptureButton"
                android:background="@drawable/ic_sfera_btn_bg"
                android:text="@string/sfera_c_btn_view" />

            <TextView
                android:id="@+id/sphere_btn_retry"
                style="@style/SferaCaptureButton"
                android:background="@drawable/ic_sfera_btn_bg"
                android:text="@string/sfera_c_btn_retry" />

            <TextView
                android:id="@+id/sphere_btn_new"
                style="@style/SferaCaptureButton"
                android:background="@drawable/ic_sfera_btn_alt_bg"
                android:text="@string/sfera_c_btn_new" />

            <TextView
                android:id="@+id/sphere_btn_zip"
                style="@style/SferaCaptureButton"
                android:background="@drawable/ic_sfera_btn_alt_bg"
                android:text="@string/sfera_c_btn_zip" />

            <TextView
                android:id="@+id/sphere_btn_sources"
                style="@style/SferaCaptureButton"
                android:background="@drawable/ic_sfera_btn_alt_bg"
                android:text="@string/sfera_c_btn_sources" />

            <TextView
                android:id="@+id/sphere_btn_cancel"
                style="@style/SferaCaptureButton"
                android:background="@drawable/ic_sfera_btn_alt_bg"
                android:text="@string/sfera_c_btn_cancel" />

            <TextView
                android:id="@+id/sphere_btn_close"
                style="@style/SferaCaptureButton"
                android:background="@drawable/ic_sfera_btn_alt_bg"
                android:text="@string/sfera_c_close" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
