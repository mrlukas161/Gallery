<?xml version="1.0" encoding="utf-8"?>
<!-- Porovnanie fotiek skupiny: panely A a B (na výšku pod sebou, na šírku vedľa seba — určí sa v kóde),
     pás fotiek (dole, na šírku vpravo a dá sa skryť), dôležité ovládanie v spodnej lište na dosah palca -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/comparator_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/compare_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_primary"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/compare_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_left_vector"
            app:tint="#FFFFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/compare_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                tools:text="Séria · 12 záberov · 3. 6. 2024" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/compare_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Označuješ do Koša · 5"
                tools:visibility="visible" />

        </LinearLayout>

        <org.fossify.commons.views.MyTextView
            android:id="@+id/compare_selection_done"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/pa_selection_done"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/compare_more"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pa_more_desc"
            android:padding="12dp"
            android:src="@drawable/ic_compare_more"
            android:tooltipText="@string/pa_more_desc"
            app:tint="#FFFFFFFF" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/compare_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/compare_stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/compare_panes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <include
                    android:id="@+id/compare_pane_a"
                    layout="@layout/compare_pane"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <View
                    android:id="@+id/compare_divider"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#FFFFFFFF" />

                <include
                    android:id="@+id/compare_pane_b"
                    layout="@layout/compare_pane"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/compare_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2" />

        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/compare_strip"
            android:layout_width="match_parent"
            android:layout_height="@dimen/compare_strip_size"
            android:background="#22FFFFFF"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/compare_info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F2202020"
        android:visibility="gone">

        <TableLayout
            android:id="@+id/compare_info_table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:stretchColumns="1,2" />

    </ScrollView>

    <LinearLayout
        android:id="@+id/compare_bottombar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_primary"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/compare_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:id="@+id/compare_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/compare_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                tools:text="Vyhodnocujem 4 / 24…" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/compare_tip_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:visibility="gone">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/compare_tip_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                tools:text="@string/pa_tip" />

            <ImageView
                android:id="@+id/compare_tip_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/pa_tip_close"
                android:padding="12dp"
                android:src="@drawable/ic_compare_close"
                android:tooltipText="@string/pa_tip_close" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/compare_undo_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF323232"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/compare_undo_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                tools:text="V Koši: 5 · 23 MB sa uvoľní po vysypaní Koša" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/compare_undo"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/pa_undo"
                android:textColor="#FFFFD54F"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/compare_duel_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:visibility="gone">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/compare_duel_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFFFF"
                tools:text="Turnaj · zápas 3 z 11" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/compare_duel_end"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/pa_duel_end"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/compare_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/compare_tools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/compare_strip_toggle"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/pa_strip_desc"
                    android:padding="10dp"
                    android:src="@drawable/ic_compare_strip"
                    android:tooltipText="@string/pa_strip_desc" />

                <ImageView
                    android:id="@+id/compare_sync"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/pa_sync_on"
                    android:padding="10dp"
                    android:src="@drawable/ic_compare_sync_on"
                    android:tooltipText="@string/pa_sync_on" />

                <ImageView
                    android:id="@+id/compare_duel"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/pa_duel_desc"
                    android:padding="10dp"
                    android:src="@drawable/ic_compare_duel"
                    android:tooltipText="@string/pa_duel_desc" />

                <ImageView
                    android:id="@+id/compare_grid_toggle"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/pa_grid_desc"
                    android:padding="10dp"
                    android:src="@drawable/ic_compare_grid"
                    android:tooltipText="@string/pa_grid_desc" />

                <ImageView
                    android:id="@+id/compare_info"
                    android:layout_width="44dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/pa_info_desc"
                    android:padding="10dp"
                    android:src="@drawable/ic_compare_info"
                    android:tooltipText="@string/pa_info_desc" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/compare_next_group"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/pa_next_group"
                    android:textSize="14sp"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/compare_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp">

                <Button
                    android:id="@+id/compare_keep_best"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:textSize="13sp"
                    tools:text="Ponechať ★, ostatné do Koša (46 MB)" />

                <Button
                    android:id="@+id/compare_delete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="2"
                    android:textSize="13sp"
                    tools:text="Do Koša: 5 (23 MB)" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
