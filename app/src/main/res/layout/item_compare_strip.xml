<?xml version="1.0" encoding="utf-8"?>
<!-- Miniatúra v páse porovnávača: ★ najlepšia, skóre, 😑 zavreté oči, A/B = v ktorom paneli je,
     označená do Koša = červené prekrytie + ikona koša (nie len farba) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/compare_strip_item"
    android:layout_height="@dimen/compare_strip_item"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:padding="2dp">

    <ImageView
        android:id="@+id/strip_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/strip_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80D32F2F"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/strip_trash"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_compare_trash_badge"
        android:contentDescription="@null"
        android:padding="6dp"
        android:src="@drawable/ic_compare_trash"
        android:visibility="gone" />

    <View
        android:id="@+id/strip_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/strip_best"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|start"
        android:layout_margin="3dp"
        android:contentDescription="@null"
        android:src="@android:drawable/btn_star_big_on"
        android:visibility="gone" />

    <TextView
        android:id="@+id/strip_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="3dp"
        android:background="#B3000000"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/strip_warn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="3dp"
        android:background="#B3000000"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:text="😑"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/strip_badge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="3dp"
        android:gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
