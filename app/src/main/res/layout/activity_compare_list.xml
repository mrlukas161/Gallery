<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/compare_list_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/compare_list_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/compare_list_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/compare_title"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

        <!-- záložky Série / Presné kópie / Podobné (s počtom skupín); pozadie preberajú od MyAppBarLayout,
             farby textu a indikátora nastaví CompareListActivity z témy -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/compare_list_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:tabMode="fixed" />

    </org.fossify.commons.views.MyAppBarLayout>

    <!-- počet stĺpcov dopočíta CompareListActivity podľa šírky (na šírku viac) -->
    <org.fossify.commons.views.MyRecyclerView
        android:id="@+id/compare_list_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="2dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:spanCount="3" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/compare_list_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:visibility="gone"
        tools:text="@string/pb_none_bursts" />

    <!-- načítanie skupín (prvé otvorenie; z pamäte sa ukážu hneď a indikátor sa vôbec neobjaví) -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/compare_list_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        app:hideAnimationBehavior="inward"
        app:showAnimationBehavior="outward"
        app:showDelay="300"
        tools:visibility="visible" />

    <!-- porovnavac-W2: po hromadnom „Ponechať najlepšiu“ — „V Koši: 87 fotiek · 412 MB…“ a „Späť“ (obnova celej
         dávky z Koša); rovnaký vzhľad ako lišta „Späť“ v porovnávači, spodný okraj pridá setupEdgeToEdge -->
    <LinearLayout
        android:id="@+id/compare_list_undo_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FF323232"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/compare_list_undo_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            tools:text="V Koši: 87 fotiek · 412 MB sa uvoľní po vysypaní Koša" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/compare_list_undo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/pa_undo"
            android:textColor="#FFFFD54F"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- „Ďalšia skupina ›“ po návrate z porovnávača; spodný okraj pod navigačným pruhom pridá setupEdgeToEdge -->
    <FrameLayout
        android:id="@+id/compare_list_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/compare_list_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/activity_margin"
            android:text="@string/pb_next_group"
            android:visibility="gone"
            tools:visibility="visible" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
