<?xml version="1.0" encoding="utf-8"?>
<!-- Výberový režim zoznamu „Podobné a duplikáty“ (podržanie dlaždice). Hromadné „Ponechať najlepšiu“ príde,
     keď bude hotové hodnotenie kvality v porovnávači. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
